---
import { site } from '../data/site';
const { active = 'Home' } = Astro.props;
const base = apxBaseUrl;
const links = [{ label: 'Home', href: base }, { label: 'About', href: `${base}about/` }, { label: 'Services', href: `${base}services/` }, { label: 'Projects', href: `${base}projects/` }, { label: 'Contact', href: `${base}contact/` }];

const apxBaseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={base} aria-label="APX home">
      <img src={`${base}logo.svg`} alt="APX geometric mark" width="46" height="46" />
      <span><strong>APX</strong><small>ARCHITECTURAL & ENGINEERING</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => <a class:list={[{ current: active === link.label }]} href={link.href}>{link.label}</a>)}
    </nav>
    <a class="nav-cta" href={`${base}contact/`}>Start a conversation <span>↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle><span></span><span></span></button>
  </div>
  <nav class="mobile-nav" aria-label="Mobile navigation" data-mobile-menu>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href={`${base}contact/`} class="mobile-cta">Start a conversation ↗</a>
  </nav>
</header>
