---
import { site } from '../data/site';
const { active = 'Home' } = Astro.props;
const links = [{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Services', href: '/services/' }, { label: 'Projects', href: '/projects/' }, { label: 'Contact', href: '/contact/' }];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="APX home">
      <img src="/logo.svg" alt="APX geometric mark" width="46" height="46" />
      <span><strong>APX</strong><small>ARCHITECTURAL & ENGINEERING</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((link) => <a class:list={[{ current: active === link.label }]} href={link.href}>{link.label}</a>)}
    </nav>
    <a class="nav-cta" href="/contact/">Start a conversation <span>↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle><span></span><span></span></button>
  </div>
  <nav class="mobile-nav" aria-label="Mobile navigation" data-mobile-menu>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="/contact/" class="mobile-cta">Start a conversation ↗</a>
  </nav>
</header>
