---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import SectionHeading from '../components/SectionHeading.astro'; import { projects } from '../data/site';
const base = apxBaseUrl;

const apxBaseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

---
<BaseLayout title="Projects | APX Architectural & Engineering Services"><Header active="Projects" /><main><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">PROJECT PORTFOLIO</span><h1>Design concepts<br /><em>and possibilities.</em></h1><p>A growing collection of architectural ideas and project presentations.</p></div></section><section class="section-pad"><div class="container"><SectionHeading eyebrow="SELECTED PROJECTS" title="A place for work worth sharing." text="This starter portfolio includes one concept based on the supplied Facebook post and two illustrative placeholders. Replace them with approved APX project materials before launch." /><div class="filters" role="group" aria-label="Filter projects"><button class="filter-button active" data-filter="All">All projects</button><button class="filter-button" data-filter="Residential">Residential</button><button class="filter-button" data-filter="Planning">Planning</button></div><div class="portfolio-grid">{projects.map((project, i) => <article class="portfolio-card" data-category={project.category}><a class="portfolio-image" href={`${base}contact/`}><img src={`${base}${project.image}`} alt={project.imageAlt} /><span class="portfolio-count">0{i+1}</span></a><div class="portfolio-meta"><span>{project.category}</span><span>{project.status}</span></div><h3>{project.title}</h3><p>{project.description}</p></article>)}</div></div></section></main><Footer /></BaseLayout>
