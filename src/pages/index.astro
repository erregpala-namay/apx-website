---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { services, projects, site } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="APX | Architectural & Engineering Services" description="Architectural and engineering design services in San Juan, Ilocos Sur. Turning visions into reality.">
  <Header active="Home" />
  <main>
    <section class="hero">
      <div class="hero-grid"></div><div class="container hero-content">
        <div class="hero-copy"><span class="eyebrow eyebrow-light">ARCHITECTURE · ENGINEERING · DESIGN</span><h1>Good spaces begin<br />with <em>good ideas.</em></h1><p>Architectural and engineering design services shaped around your vision, your needs, and the way you want to live.</p><div class="hero-actions"><a class="button button-light" href={`${base}projects/`}>Explore our work <span>↗</span></a><a class="text-link text-link-light" href={`${base}contact/`}>Talk to APX <span>→</span></a></div><div class="hero-note"><span class="note-line"></span><span>TURNING VISIONS INTO REALITY</span></div></div>
        <div class="hero-art"><img src={`${base}images/house-elevation.svg`} alt="Original architectural illustration of a contemporary elevated bungalow" /><div class="art-caption"><span>DESIGN PERSPECTIVE</span><strong>01 / RESIDENTIAL</strong></div></div>
      </div><div class="hero-index">APX <span>—</span> 01</div>
    </section>
    <section class="intro-section section-pad"><div class="container intro-grid"><div class="intro-mark"><span>APX</span><div class="mark-geometry">A</div><small>DESIGN WITH INTENTION</small></div><div class="intro-copy"><span class="eyebrow">A DESIGN-LED APPROACH</span><h2>From the first sketch<br />to a clearer vision.</h2><p>Every project starts with understanding. APX brings architectural thinking and engineering design together to help shape spaces that feel considered, functional, and distinctly yours.</p><a class="text-link" href={`${base}about/`}>Get to know APX <span>→</span></a></div></div></section>
    <section class="services-section section-pad"><div class="container"><SectionHeading eyebrow="WHAT WE DO" title="Design services, built around your needs." text="Explore the design areas APX can discuss with you. Final scope and professional services are confirmed during project consultation." /><div class="service-grid">{services.slice(0,4).map((service) => <article class="service-card"><span class="service-number">{service.number}</span><span class="service-icon">{service.icon}</span><h3>{service.title}</h3><p>{service.description}</p><a href={`${base}services/`} aria-label={`Learn about ${service.title}`}>↗</a></article>)}</div><div class="section-end-link"><a class="text-link" href={`${base}services/`}>View all services <span>→</span></a></div></div></section>
    <section class="project-section section-pad"><div class="container"><div class="project-heading"><SectionHeading eyebrow="SELECTED WORK" title="Ideas taking shape." text="A first look at the kind of architectural presentation APX wants to share. Portfolio examples are clearly identified until actual project materials are supplied." /><a class="text-link" href={`${base}projects/`}>Explore portfolio <span>→</span></a></div><div class="featured-project"><div class="featured-image"><img src={`${base}images/house-elevation.svg`} alt="Original line illustration of a modern elevated bungalow" /><span class="image-tag">FEATURED DESIGN CONCEPT</span></div><div class="featured-info"><span class="eyebrow">RESIDENTIAL · CONCEPT PRESENTATION</span><h3>Modern Elevated<br />Bungalow House Design</h3><p>A modern residential concept with two spacious bedrooms, one common CR, and a stylish living area—bringing comfort and everyday function into one considered layout.</p><a class="button button-dark" href={`${base}projects/`}>View project details <span>↗</span></a><small>Illustrative concept artwork. Replace with approved APX project images before launch.</small></div></div></div></section>
    <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">HAVE A PROJECT IN MIND?</span><h2>Let’s start with<br /><em>a conversation.</em></h2></div><div class="cta-right"><p>Tell us what you are planning. We would be glad to hear about your ideas and discuss a possible next step.</p><a class="button button-light" href={`${base}contact/`}>Contact APX <span>↗</span></a></div></div></section>
  </main>
  <Footer />
</BaseLayout>
